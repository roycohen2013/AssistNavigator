# Local ASSIST library — downloaded PDFs, DB, logs. Never commit.
/library/
*.db
*.db-wal
*.db-shm
*.pdf

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Node
node_modules/
frontend/dist/
.vite/

# Env / secrets
.env
.env.*
!.env.example

# Agent skills — installed via `npx skills@latest add <source>`.
# Skill content is third-party and reproducible from skills-lock.json, so it is
# not vendored here. .claude/skills holds symlinks into .agents/skills, which do
# not travel across machines. skills-lock.json IS tracked.
.agents/
.claude/skills/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
